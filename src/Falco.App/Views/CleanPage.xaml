<UserControl x:Class="Falco.App.Views.CleanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,8,24,16">
      <Button Style="{StaticResource BackLink}" Content="{DynamicResource nav.back}" Margin="0,2,0,6" Click="OnBack"/>

      <!-- 系统层 -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="4,0,0,6">
            <TextBlock Text="{DynamicResource clean.sys.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.scan}" Margin="8,0,0,0" Click="OnSysScan"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.clean.selected}" Margin="8,0,0,0" Click="OnSysClean"/>
            <TextBlock x:Name="SysRes" Text="{DynamicResource clean.sys.hint}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </DockPanel>
          <StackPanel x:Name="SysList" Margin="4,2,4,0"/>
        </StackPanel>
      </Border>

      <!-- 构建产物 -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="4,0,0,6">
            <TextBlock Text="{DynamicResource clean.purge.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.none}" Margin="8,0,0,0" Click="OnPurgeNone"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.all}" Margin="8,0,0,0" Click="OnPurgeAll"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.delete.selected}" Margin="8,0,0,0" Click="OnPurgeClean"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.purge.scan}" Margin="8,0,0,0" Click="OnPurgeScan"/>
            <TextBlock x:Name="PurgeRes" Text="{DynamicResource clean.purge.hint}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <StackPanel x:Name="PurgeList" Margin="4,2,4,0" MaxHeight="260"/>
        </StackPanel>
      </Border>

      <!-- 开发缓存（白名单） -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="4,0,0,6">
            <TextBlock Text="{DynamicResource clean.cache.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.clean.selected}" Margin="8,0,0,0" Click="OnCacheClean"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.scan}" Margin="8,0,0,0" Click="OnCacheScan"/>
            <TextBlock x:Name="CacheRes" Text="{DynamicResource clean.cache.hint}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <StackPanel x:Name="CacheList" Margin="4,2,4,0" MaxHeight="240"/>
        </StackPanel>
      </Border>

      <!-- 安装包 -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="4,0,0,6">
            <TextBlock Text="{DynamicResource clean.inst.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.delete.selected}" Margin="8,0,0,0" Click="OnInstClean"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.inst.scan}" Margin="8,0,0,0" Click="OnInstScan"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgBtn}" Content="{DynamicResource clean.inst.otherfolder}" Margin="8,0,0,0" Click="OnInstFolder"/>
            <TextBlock x:Name="InstRes" Text="{DynamicResource clean.inst.hint}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <StackPanel x:Name="InstList" Margin="4,2,4,0" MaxHeight="220"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
